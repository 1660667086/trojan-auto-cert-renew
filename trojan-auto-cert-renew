import sys

config_path, key_path = sys.argv[1], sys.argv[2]
try:
    with open(config_path, encoding="utf-8") as f:
        data = json.load(f)
    for key in key_path.split("."):
        if not isinstance(data, dict):
            data = ""
            break
        data = data.get(key, "")
    print(data if isinstance(data, str) else "")
except Exception:
    print("")
PY
    elif command -v python >/dev/null 2>&1; then
        python - "$CONFIG_PATH" "$path" <<'PY'
import json
import sys

config_path, key_path = sys.argv[1], sys.argv[2]
try:
    with open(config_path) as f:
        data = json.load(f)
    for key in key_path.split("."):
        if not isinstance(data, dict):
            data = ""
            break
        data = data.get(key, "")
    print(data if isinstance(data, str) else "")
except Exception:
    print("")
PY
    fi
}

persist_domain_to_config() {
    local python_cmd

    if command -v python3 >/dev/null 2>&1; then
        python_cmd="python3"
    elif command -v python >/dev/null 2>&1; then
        python_cmd="python"
    else
        return 1
    fi

    "$python_cmd" - "$CONFIG_PATH" "$DOMAIN" <<'PY'
import json
import io
import os
import sys
import tempfile

config_path, domain = sys.argv[1], sys.argv[2]
with io.open(config_path, "r", encoding="utf-8") as f:
    data = json.load(f)

ssl = data.setdefault("ssl", {})
if not isinstance(ssl, dict):
    raise ValueError("ssl config is not an object")
if ssl.get("sni") == domain:
    raise SystemExit(0)

ssl["sni"] = domain
stat = os.stat(config_path)
directory = os.path.dirname(config_path) or "."
fd, temp_path = tempfile.mkstemp(prefix=".trojan-config.", dir=directory)
try:
    os.fchmod(fd, stat.st_mode & 0o7777)
    with io.open(fd, "w", encoding="utf-8", closefd=True) as f:
        json.dump(data, f, ensure_ascii=False, indent=4)
        f.write("\n")
    os.chown(temp_path, stat.st_uid, stat.st_gid)
    os.rename(temp_path, config_path)
except Exception:
    try:
        os.close(fd)
    except OSError:
        pass
    try:
        os.unlink(temp_path)
    except OSError:
        pass
    raise
PY
    log "[OK] 已将域名写入 Trojan 配置 ssl.sni: $DOMAIN"
}

service_exists() {
    local svc="$1"
    local state
    svc="${svc%.service}"
    state="$(systemctl show -p LoadState "${svc}.service" 2>/dev/null \
        | sed -n 's/^LoadState=//p' \
        | head -n 1)"
    [ -n "$state" ] && [ "$state" != "not-found" ]
}

service_active() {
    local svc="$1"
    svc="${svc%.service}"
    systemctl is-active --quiet "$svc"
}

service_text() {
    local svc
    for svc in trojan trojan-go; do
        service_exists "$svc" && systemctl cat "$svc" 2>/dev/null || true
    done
}

detect_trojan_cli() {
    [ -n "$TROJAN_CLI" ] && return 0

    local candidate
    for candidate in /usr/local/bin/trojan /usr/bin/trojan /usr/bin/trojan/trojan; do
        if [ -x "$candidate" ]; then
            TROJAN_CLI="$candidate"
            return 0
        fi
    done

    TROJAN_CLI="$(command -v trojan 2>/dev/null || true)"
    [ -n "$TROJAN_CLI" ] || die "could not find Trojan management command; set TROJAN_CLI=/path/to/trojan"
}

detect_config_path() {
    [ -n "$CONFIG_PATH" ] && return 0

    CONFIG_PATH="$(service_text | awk '
        match($0, /-config[= ]+[^ ]+/) {
            s=substr($0, RSTART, RLENGTH)
            sub(/^-config[= ]+/, "", s)
            print s
            exit
        }')"

    if [ -z "$CONFIG_PATH" ]; then
        CONFIG_PATH="$(ps -eo args 2>/dev/null | awk '
            tolower($0) ~ /trojan/ && match($0, /-config[= ]+[^ ]+/) {
                s=substr($0, RSTART, RLENGTH)
                sub(/^-config[= ]+/, "", s)
                print s
                exit
            }')"
    fi

    if [ -z "$CONFIG_PATH" ]; then
        for candidate in \
            /usr/local/etc/trojan/config.json \
            /usr/local/etc/trojan-go/config.json \
            /etc/trojan/config.json \
            /etc/trojan-go/config.json; do
            if [ -f "$candidate" ]; then
                CONFIG_PATH="$candidate"
                break
            fi
        done
    fi

    [ -n "$CONFIG_PATH" ] || die "could not detect Trojan config; set CONFIG_PATH=/path/to/config.json"
    [ -f "$CONFIG_PATH" ] || die "Trojan config not found: $CONFIG_PATH"
}

trojan_service_candidates() {
    local svc

    if [ -n "$TROJAN_SERVICE" ]; then
        for svc in $TROJAN_SERVICE; do
            printf '%s\n' "${svc%.service}"
        done
        return 0
    fi

    {
        for svc in trojan trojan-go; do
            service_exists "$svc" && printf '%s\n' "$svc"
        done

        systemctl list-units --type=service --all --no-legend 2>/dev/null \
            | awk '{print $1}'
        systemctl list-unit-files --type=service --no-legend 2>/dev/null \
            | awk '{print $1}'
    } | awk '
        {
            svc=$1
            sub(/\.service$/, "", svc)
            low=tolower(svc)
            if (low ~ /^trojan/ && low !~ /(web|ip-limit|limit|panel)/) {
                print svc
            }
        }
    ' | awk 'NF && !seen[$0]++'
}

domain_from_trojan_info() {
    TERM=xterm "$TROJAN_CLI" info 2>/dev/null \
        | sed -E 's/\x1B\[[0-9;]*[mK]//g' \
        | sed -n 's#.*trojan://[^@]*@\([^:/?#]*\).*#\1#p' \
        | head -n 1
}

normalize_domain() {
    local value="$1"
    value="${value#http://}"
    value="${value#https://}"
    value="${value%%/*}"
    value="${value%%:*}"
    value="${value%.}"
    printf '%s' "$value" | tr '[:upper:]' '[:lower:]'
}

valid_domain() {
    local value="$1"
    [ -n "$value" ] || return 1
    [ "${value#\*.}" = "$value" ] || return 1
    printf '%s\n' "$value" | grep -Eq '^([0-9]{1,3}\.){3}[0-9]{1,3}$' && return 1
    printf '%s\n' "$value" | grep -Eiq '^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$'
}

accept_domain() {
    local source="$1"
    local value
    value="$(normalize_domain "$2")"
    valid_domain "$value" || return 1
    DOMAIN="$value"
    DOMAIN_SOURCE="$source"
    return 0
}

domain_from_current_cert() {
    local cert value
    cert="$(current_cert_path)"
    [ -n "$cert" ] && [ -s "$cert" ] || return 0

    value="$(openssl x509 -in "$cert" -noout -ext subjectAltName 2>/dev/null \
        | tr ',' '\n' \
        | sed -n 's/.*DNS:[[:space:]]*\([^[:space:]]*\).*/\1/p' \
        | head -n 1 || true)"
    if [ -n "$value" ]; then
        printf '%s\n' "$value"
        return 0
    fi

    openssl x509 -in "$cert" -noout -subject 2>/dev/null \
        | sed -n -E 's/.*CN[[:space:]]*=[[:space:]]*([^,\/[:space:]]+).*/\1/p' \
        | head -n 1 || true
}

domain_from_cert_path() {
    local cert directory
    cert="$(current_cert_path)"
    [ -n "$cert" ] || return 0
    directory="$(basename "$(dirname "$cert")")"
    directory="${directory%_ecc}"
    printf '%s\n' "$directory"
}

detect_domain() {
    local value

    if [ -n "$DOMAIN" ]; then
        value="$DOMAIN"
        DOMAIN=""
        accept_domain "environment variable DOMAIN" "$value" \
            || die "invalid DOMAIN value: $value"
        return 0
    fi

    for path in ssl.sni sni server_name domain host; do
        value="$(json_get "$path" | tr -d '[:space:]')"
        if accept_domain "Trojan config field $path" "$value"; then
            return 0
        fi
    done

    value="$(domain_from_trojan_info | tr -d '[:space:]')"
    accept_domain "trojan info share link" "$value" && return 0

    value="$(domain_from_current_cert | tr -d '[:space:]')"
    accept_domain "current certificate" "$value" && return 0

    value="$(domain_from_cert_path | tr -d '[:space:]')"
    accept_domain "current certificate path" "$value" && return 0

    die "could not auto-detect a valid domain from Trojan config, 'trojan info', or the current certificate; set DOMAIN=www.example.com"
}

current_cert_path() {
    json_get ssl.cert | tr -d '[:space:]'
}

current_key_path() {
    json_get ssl.key | tr -d '[:space:]'
}

cert_is_fresh() {
    local cert="$1"
    [ -n "$cert" ] || return 1
    [ -s "$cert" ] || return 1
    openssl x509 -in "$cert" -noout -checkend "$((RENEW_DAYS * 86400))" >/dev/null 2>&1
}

cert_end_date() {
    local cert="$1"
    [ -n "$cert" ] && [ -s "$cert" ] || return 0
    openssl x509 -in "$cert" -noout -enddate 2>/dev/null | sed 's/^notAfter=//'
}

format_cert_date() {
    local raw="$1"
    [ -n "$raw" ] || return 0

    if command -v date >/dev/null 2>&1; then
        TZ="$DISPLAY_TZ" date -d "$raw" '+%Y 年 %-m 月 %-d 日 %H:%M:%S' 2>/dev/null && return 0
        TZ="$DISPLAY_TZ" date -j -f '%b %e %T %Y %Z' "$raw" '+%Y 年 %-m 月 %-d 日 %H:%M:%S' 2>/dev/null && return 0
    fi

    printf '%s\n' "$raw"
}

cert_subject() {
    local cert="$1"
    [ -n "$cert" ] && [ -s "$cert" ] || return 0
    openssl x509 -in "$cert" -noout -subject 2>/dev/null | sed 's/^subject= *//'
}

cert_issuer() {
    local cert="$1"
    [ -n "$cert" ] && [ -s "$cert" ] || return 0
    openssl x509 -in "$cert" -noout -issuer 2>/dev/null | sed 's/^issuer= *//'
}

validate_cert_files() {
    local cert="$1"
    local key="$2"
    [ -s "$cert" ] || return 1
    [ -s "$key" ] || return 1
    openssl x509 -in "$cert" -noout >/dev/null 2>&1 || return 1
    openssl pkey -in "$key" -noout >/dev/null 2>&1 || return 1
    openssl x509 -in "$cert" -noout -checkend 86400 >/dev/null 2>&1 || return 1
}

print_status_report() {
    local cert="$1"
    local key="$2"
    local end_date subject issuer

    log "[OK] 自动续签脚本可读取 Trojan 配置"
    log "域名: $DOMAIN"
    log "域名来源: $DOMAIN_SOURCE"
    log "配置文件: $CONFIG_PATH"
    log "Trojan 命令: $TROJAN_CLI"
    log "证书文件: ${cert:-未配置}"
    log "私钥文件: ${key:-未配置}"

    if validate_cert_files "$cert" "$key"; then
        end_date="$(cert_end_date "$cert")"
        subject="$(cert_subject "$cert")"
        issuer="$(cert_issuer "$cert")"

        if cert_is_fresh "$cert"; then
            log "[OK] 证书已安装且有效"
        else
            log "[WARN] 证书已安装，但会在 ${RENEW_DAYS} 天内过期"
        fi
        [ -n "$subject" ] && log "证书主体: $subject"
        [ -n "$issuer" ] && log "签发机构: $issuer"
        [ -n "$end_date" ] && log "到期时间: $(format_cert_date "$end_date")"
        return 0
    fi

    log "[WARN] 未检测到有效证书或私钥"
    log "可以运行: $0 --force"
    return 1
}

print_success_report() {
    local cert="$1"
    local key="$2"
    local end_date svc found
    end_date="$(cert_end_date "$cert")"
    found=0

    log "============================================================"
    log "[OK] 证书申请并安装成功"
    log "域名: $DOMAIN"
    log "域名来源: $DOMAIN_SOURCE"
    log "证书文件: $cert"
    log "私钥文件: $key"
    log "到期时间: $(format_cert_date "$end_date")"

    while IFS= read -r svc; do
        [ -n "$svc" ] || continue
        found=1
        if service_active "$svc"; then
            log "Trojan 服务: $svc (运行中)"
        else
            log "[WARN] Trojan 服务: $svc (未运行)"
        fi
    done < <(trojan_service_candidates)

    [ "$found" = "1" ] || log "[WARN] 未识别到 Trojan systemd 服务"
    log "============================================================"
}

disable_acme_cron() {
    [ "$DISABLE_ACME_CRON" = "1" ] || return 0
    command -v crontab >/dev/null 2>&1 || return 0

    local tmp
    tmp="$(mktemp)"
    crontab -l 2>/dev/null | grep -v '\.acme\.sh.*/acme\.sh --cron' > "$tmp" || true
    crontab "$tmp" || true
    rm -f "$tmp"
}

restore_services() {
    local i svc

    if [ "$TROJAN_WEB_WAS_ACTIVE" != "1" ] \
        && service_exists trojan-web \
        && service_active trojan-web; then
        log "Stopping trojan-web because it was inactive before renewal"
        systemctl stop trojan-web || true
    fi

    if ! wait_for_port80_free "$PORT_RELEASE_WAIT"; then
        log "[WARN] 端口 80 在等待 ${PORT_RELEASE_WAIT} 秒后仍被占用，继续尝试恢复服务"
        port80_listeners || true
    fi

    if [ "$STARTED_SERVICES_COUNT" -gt 0 ]; then
        log "Restoring services..."
        for ((i=STARTED_SERVICES_COUNT-1; i>=0; i--)); do
            svc="${STARTED_SERVICES[$i]}"
            log "Starting $svc"
            systemctl start "$svc" || true
        done
    fi

    if [ "$ALWAYS_START_TROJAN" = "1" ]; then
        recover_trojan_services || true
    fi
}

recover_trojan_services() {
    local svc found failed
    found=0
    failed=0

    while IFS= read -r svc; do
        [ -n "$svc" ] || continue
        found=1

        if service_active "$svc"; then
            log "[OK] Trojan service is running: $svc"
            continue
        fi

        log "Starting Trojan service: $svc"
        systemctl start "$svc" || systemctl restart "$svc" || true

        if service_active "$svc"; then
            log "[OK] Trojan service started: $svc"
        else
            log "[WARN] Trojan service is still not active: $svc"
            failed=1
        fi
    done < <(trojan_service_candidates)

    if [ "$found" = "0" ]; then
        log "[WARN] No Trojan systemd service detected. Set TROJAN_SERVICE=your-service-name if needed."
        return 1
    fi

    return "$failed"
}

restart_trojan_services() {
    local svc found failed
    found=0
    failed=0

    while IFS= read -r svc; do
        [ -n "$svc" ] || continue
        found=1
        log "Restarting Trojan service: $svc"
        systemctl restart "$svc" || {
            systemctl stop "$svc" || true
            systemctl start "$svc" || true
        }

        if service_active "$svc"; then
            log "[OK] Trojan 服务已重启并运行: $svc"
        else
            log "[WARN] Trojan 服务重启后未运行: $svc"
            failed=1
        fi
    done < <(trojan_service_candidates)

    if [ "$found" = "0" ]; then
        log "[WARN] 未识别到 Trojan systemd 服务；如服务名特殊，请设置 TROJAN_SERVICE=服务名"
        return 1
    fi

    return "$failed"
}

fail_with_restore() {
    local backup="$1"
    shift
    log "ERROR: $*"
    if [ -n "$backup" ] && [ -s "$backup" ]; then
        cp -a "$backup" "$CONFIG_PATH"
        log "Restored Trojan config from $backup"
    fi
    exit 1
}

stop_active_services() {
    local svc existing

    if service_exists trojan-web && service_active trojan-web; then
        TROJAN_WEB_WAS_ACTIVE=1
    fi

    for svc in $SERVICE_STOP_LIST $(trojan_service_candidates); do
        svc="${svc%.service}"
        if service_exists "$svc" && service_active "$svc"; then
            if [ "$STARTED_SERVICES_COUNT" -gt 0 ]; then
                for existing in "${STARTED_SERVICES[@]}"; do
                    [ "$existing" = "$svc" ] && continue 2
                done
            fi
            STARTED_SERVICES[$STARTED_SERVICES_COUNT]="$svc"
            STARTED_SERVICES_COUNT=$((STARTED_SERVICES_COUNT + 1))
        fi
    done

    if [ "$STARTED_SERVICES_COUNT" -gt 0 ]; then
        for svc in "${STARTED_SERVICES[@]}"; do
            log "Stopping $svc"
            systemctl stop "$svc"
        done
    fi
}

port80_listeners() {
    if command -v ss >/dev/null 2>&1; then
        ss -lntp 2>/dev/null | awk '$4 ~ /:80$/ {print}'
    elif command -v netstat >/dev/null 2>&1; then
        netstat -lntp 2>/dev/null | awk '$4 ~ /:80$/ {print}'
    elif command -v lsof >/dev/null 2>&1; then
        lsof -nP -iTCP:80 -sTCP:LISTEN 2>/dev/null || true
    fi
}

check_port80_free() {
    local listeners
    listeners="$(port80_listeners)"
    if [ -n "$listeners" ]; then
        printf '%s\n' "$listeners"
        return 1
    fi
    return 0
}

wait_for_port80_free() {
    local timeout="$1"
    local elapsed=0

    while ! check_port80_free >/dev/null 2>&1; do
        if [ "$elapsed" -eq 0 ]; then
            log "等待证书验证进程释放端口 80..."
        fi
        [ "$elapsed" -lt "$timeout" ] || return 1
        sleep 1
        elapsed=$((elapsed + 1))
    done
    return 0
}

run_trojan_tls() {
    need_cmd expect

    expect <<EXP
set timeout -1
set env(TERM) "xterm"
set domain "$DOMAIN"
set cert_choice "$CERT_CHOICE"
spawn "$TROJAN_CLI" tls
sleep 1
send "\$cert_choice\r"
sleep 1
send -- "\$domain\r"
expect {
  eof {
    catch wait result
    exit [lindex \$result 3]
  }
}
EXP
}

main() {
    need_root

    if [ "$INSTALL_MODE" = "1" ] && [ "$UNINSTALL_MODE" = "1" ]; then
        die "--install and --uninstall cannot be used together"
    fi

    if [ "$INSTALL_MODE" = "1" ]; then
        run_installer
        exit $?
    fi

    if [ "$UNINSTALL_MODE" = "1" ]; then
        run_uninstaller
        exit $?
    fi

    mkdir -p "$(dirname "$LOG_FILE")"
    touch "$LOG_FILE"
    exec > >(tee -a "$LOG_FILE") 2>&1

    need_cmd systemctl

    if [ "$RECOVER" = "1" ]; then
        recover_trojan_services
        exit $?
    fi

    if [ "$RESTART" = "1" ]; then
        restart_trojan_services
        exit $?
    fi

    need_cmd openssl
    detect_trojan_cli
    detect_config_path
    detect_domain

    [ "$CERT_CHOICE" = "1" ] || die "only CERT_CHOICE=1 (Let's Encrypt) is supported for unattended renewal"

    local cert key end_date backup
    cert="$(current_cert_path)"
    key="$(current_key_path)"

    log "Detected domain: $DOMAIN"
    log "Detected domain source: $DOMAIN_SOURCE"
    log "Detected config: $CONFIG_PATH"
    log "Detected Trojan CLI: $TROJAN_CLI"
    log "Configured cert: ${cert:-unknown}"

    if [ "$STATUS" = "1" ]; then
        print_status_report "$cert" "$key"
        exit $?
    fi

    if [ "$DRY_RUN" = "1" ]; then
        print_status_report "$cert" "$key" || true
        log "Dry run finished."
        exit 0
    fi

    if [ "$SCHEDULED" = "1" ] && [ "$FORCE" != "1" ] && cert_is_fresh "$cert"; then
        end_date="$(cert_end_date "$cert")"
        log "[OK] 定时检查完成：证书剩余有效期超过 ${RENEW_DAYS} 天，无需申请"
        log "域名: $DOMAIN"
        log "到期时间: $(format_cert_date "$end_date")"
        disable_acme_cron
        exit 0
    fi

    if [ "$SCHEDULED" = "1" ] && [ "$FORCE" != "1" ]; then
        log "定时检查发现证书缺失或将在 ${RENEW_DAYS} 天内过期，立即申请并安装"
    else
        log "手动运行模式：已自动识别域名，将立即申请并安装新证书"
    fi

    mkdir -p "$BACKUP_DIR"
    backup="${BACKUP_DIR}/config.json.$(date '+%Y%m%d%H%M%S')"
    cp -a "$CONFIG_PATH" "$backup"
    log "Backed up Trojan config to $backup"

    trap 'code=$?; restore_services; exit $code' EXIT

    stop_active_services
    sleep 2
    check_port80_free || fail_with_restore "$backup" "port 80 is still occupied after stopping known services"

    log "Running Trojan certificate tool for $DOMAIN"
    run_trojan_tls || fail_with_restore "$backup" "Trojan certificate tool exited with failure"

    cert="$(current_cert_path)"
    key="$(current_key_path)"
    log "Trojan now points to cert: ${cert:-unknown}"
    validate_cert_files "$cert" "$key" || fail_with_restore "$backup" "new certificate/key validation failed"
    persist_domain_to_config || fail_with_restore "$backup" "could not save the domain to Trojan config ssl.sni"

    disable_acme_cron
    restore_services
    trap - EXIT
    print_success_report "$cert" "$key"
}

main "$@"
