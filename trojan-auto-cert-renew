#!/usr/bin/env bash
set -Eeuo pipefail
export LC_ALL=C
export LANG=C

PREFIX="${PREFIX:-/usr/local}"
INSTALL_PATH="${INSTALL_PATH:-${PREFIX}/sbin/trojan-auto-cert-renew}"
CRON_FILE="${CRON_FILE:-/etc/cron.d/trojan-auto-cert-renew}"
RAW_BASE="${RAW_BASE:-https://raw.githubusercontent.com/1660667086/trojan-auto-cert-renew/main}"
CONFIG_PATH="${CONFIG_PATH:-}"
DOMAIN="${DOMAIN:-}"
TROJAN_CLI="${TROJAN_CLI:-}"
TROJAN_SERVICE="${TROJAN_SERVICE:-}"
RENEW_DAYS="${RENEW_DAYS:-15}"
LOG_FILE="${LOG_FILE:-/var/log/trojan-auto-cert-renew.log}"
BACKUP_DIR="${BACKUP_DIR:-/root/trojan-cert-backups}"
CERT_CHOICE="${CERT_CHOICE:-1}"
DISABLE_ACME_CRON="${DISABLE_ACME_CRON:-1}"
SERVICE_STOP_LIST="${SERVICE_STOP_LIST:-trojan trojan-go trojan-web nginx caddy apache2 httpd cloudreve}"
ALWAYS_START_TROJAN="${ALWAYS_START_TROJAN:-1}"
DISPLAY_TZ="${DISPLAY_TZ:-Asia/Shanghai}"
PORT_RELEASE_WAIT="${PORT_RELEASE_WAIT:-20}"
CHECK_MINUTE="${CHECK_MINUTE:-17}"
CHECK_HOUR="${CHECK_HOUR:-4}"
DAILY_RESTART="${DAILY_RESTART:-1}"
RESTART_MINUTE="${RESTART_MINUTE:-47}"
RESTART_HOUR="${RESTART_HOUR:-4}"
RUN_CHECK="${RUN_CHECK:-1}"
INSTALL_ACTION="${INSTALL_ACTION:-ask}"
MANUAL_DOMAIN="${MANUAL_DOMAIN:-}"
FIX_APT_ARCHIVE="${FIX_APT_ARCHIVE:-0}"
PURGE="${PURGE:-0}"
DOMAIN_SOURCE=""

INSTALL_MODE=0
UNINSTALL_MODE=0
FORCE=0
SCHEDULED=0
DRY_RUN=0
STATUS=0
RECOVER=0
RESTART=0
STARTED_SERVICES=()
STARTED_SERVICES_COUNT=0
TROJAN_WEB_WAS_ACTIVE=0

invoked_by_cron() {
    [ "${TROJAN_AUTO_CERT_CRON:-0}" = "1" ] && return 0

    local pid comm next_pid hops
    pid="$PPID"
    hops=0
    while [ "$pid" -gt 1 ] 2>/dev/null && [ "$hops" -lt 5 ]; do
        comm="$(ps -p "$pid" -o comm= 2>/dev/null | tr -d '[:space:]')"
        case "$comm" in
            cron|crond|CRON)
                return 0
                ;;
        esac
        next_pid="$(ps -p "$pid" -o ppid= 2>/dev/null | tr -d '[:space:]')"
        case "$next_pid" in
            ''|*[!0-9]*) break ;;
        esac
        pid="$next_pid"
        hops=$((hops + 1))
    done
    return 1
}

usage() {
    cat <<'USAGE'
Usage:
  trojan-auto-cert-renew --install
  trojan-auto-cert-renew --uninstall [--purge]
  trojan-auto-cert-renew
  trojan-auto-cert-renew --scheduled
  trojan-auto-cert-renew [--force] [--dry-run] [--status] [--recover] [--restart]

Modes:
  --install       Install this script, dependencies and scheduled tasks
  --uninstall     Remove this script and its scheduled tasks
  --purge         With --uninstall, also remove logs and config backups
  no argument     Auto-detect the domain and immediately request/install a certificate
  --scheduled     Check expiry first; renew only within RENEW_DAYS (used by cron)
  --force         Immediately request/install a certificate
  --status        Show the detected domain, certificate and expiry
  --dry-run       Test auto-detection without requesting a certificate
  --recover       Start detected Trojan core services
  --restart       Restart detected Trojan core services

Environment variables:
  CONFIG_PATH=/usr/local/etc/trojan/config.json
  DOMAIN=www.example.com
  TROJAN_CLI=/usr/local/bin/trojan
  TROJAN_SERVICE=trojan
  RENEW_DAYS=15
  CHECK_HOUR=4
  CHECK_MINUTE=17
  DAILY_RESTART=1
  RESTART_HOUR=4
  RESTART_MINUTE=47
  INSTALL_ACTION=ask
  MANUAL_DOMAIN=www.example.com
  FIX_APT_ARCHIVE=0
  DISPLAY_TZ=Asia/Shanghai
  SERVICE_STOP_LIST="trojan nginx cloudreve"
  ALWAYS_START_TROJAN=1
  CERT_CHOICE=1

Default manual behavior:
  Detect the Trojan domain and immediately request/install a Let's Encrypt
  certificate. The installed cron job uses --scheduled to avoid repeated issuance.
USAGE
}

while [ "$#" -gt 0 ]; do
    case "$1" in
        --install|install)
            INSTALL_MODE=1
            ;;
        --uninstall|uninstall)
            UNINSTALL_MODE=1
            ;;
        --purge|purge)
            PURGE=1
            ;;
        --force|force)
            FORCE=1
            ;;
        --scheduled|scheduled|--auto|auto)
            SCHEDULED=1
            ;;
        --dry-run|dry-run)
            DRY_RUN=1
            ;;
        --status|status)
            STATUS=1
            ;;
        --recover|recover)
            RECOVER=1
            ;;
        --restart|restart)
            RESTART=1
            ;;
        --help|-h)
            usage
            exit 0
            ;;
        *)
            echo "[trojan-auto-cert] ERROR: unknown argument: $1" >&2
            usage >&2
            exit 2
            ;;
    esac
    shift
done

if [ "$PURGE" = "1" ] && [ "$INSTALL_MODE" != "1" ]; then
    UNINSTALL_MODE=1
fi

if [ "$SCHEDULED" != "1" ] \
    && [ "$STATUS" != "1" ] \
    && [ "$DRY_RUN" != "1" ] \
    && [ "$RECOVER" != "1" ] \
    && [ "$RESTART" != "1" ] \
    && [ "$INSTALL_MODE" != "1" ] \
    && [ "$UNINSTALL_MODE" != "1" ]; then
    if invoked_by_cron; then
        SCHEDULED=1
    else
        FORCE=1
    fi
fi

log() {
    printf '%s %s\n' "$(date '+%F %T')" "$*"
}

die() {
    log "ERROR: $*"
    exit 1
}

need_root() {
    [ "$(id -u)" -eq 0 ] || die "please run as root"
}

need_cmd() {
    command -v "$1" >/dev/null 2>&1 || die "missing command: $1"
}

has_cmd() {
    command -v "$1" >/dev/null 2>&1
}

os_codename() {
    if [ -r /etc/os-release ]; then
        . /etc/os-release
        printf '%s' "${VERSION_CODENAME:-}"
    fi
}

configure_debian_buster_archive() {
    local codename backup_dir file
    codename="$(os_codename)"
    [ "$codename" = "buster" ] || die "Debian archive repair only supports Debian 10 buster; detected: ${codename:-unknown}"

    backup_dir="/root/apt-sources-backup-$(date '+%Y%m%d%H%M%S')"
    mkdir -p "$backup_dir"

    [ -f /etc/apt/sources.list ] && cp -a /etc/apt/sources.list "$backup_dir/sources.list"
    if [ -d /etc/apt/sources.list.d ]; then
        cp -a /etc/apt/sources.list.d "$backup_dir/sources.list.d" 2>/dev/null || true
    fi

    log "Backing up APT sources to $backup_dir"
    for file in /etc/apt/sources.list /etc/apt/sources.list.d/*.list; do
        [ -f "$file" ] || continue
        sed -i.bak '/buster/ s/^/# disabled by trojan-auto-cert: /' "$file"
    done

    cat > /etc/apt/sources.list.d/debian-buster-archive.list <<'EOF'
deb http://archive.debian.org/debian buster main contrib non-free
deb http://archive.debian.org/debian buster-updates main contrib non-free
deb http://archive.debian.org/debian-security buster/updates main contrib non-free
EOF

    cat > /etc/apt/apt.conf.d/99trojan-auto-cert-archive <<'EOF'
Acquire::Check-Valid-Until "false";
EOF

    log "Switched Debian buster APT sources to archive.debian.org"
}

apt_update_or_fix() {
    if apt-get update; then
        return 0
    fi

    if [ "$FIX_APT_ARCHIVE" = "1" ] || [ "$(os_codename)" = "buster" ]; then
        log "apt-get update failed; trying the Debian buster archive source..."
        configure_debian_buster_archive
        apt-get update
        return 0
    fi

    die "apt-get update failed; repair the configured package sources and rerun --install"
}

install_packages() {
    local packages=()
    local package

    for package in bash curl openssl expect socat; do
        has_cmd "$package" || packages+=("$package")
    done

    if ! has_cmd python3 && ! has_cmd python; then
        packages+=(python3)
    fi

    if ! has_cmd crontab; then
        if has_cmd apt-get; then
            packages+=(cron)
        else
            packages+=(cronie)
        fi
    fi

    [ "${#packages[@]}" -eq 0 ] && return 0

    log "Installing dependencies: ${packages[*]}"
    if has_cmd apt-get; then
        apt_update_or_fix
        DEBIAN_FRONTEND=noninteractive apt-get install -y "${packages[@]}"
    elif has_cmd dnf; then
        dnf install -y "${packages[@]}"
    elif has_cmd yum; then
        yum install -y "${packages[@]}"
    elif has_cmd zypper; then
        zypper --non-interactive install "${packages[@]}"
    else
        die "unsupported package manager; please install manually: ${packages[*]}"
    fi
}

install_self() {
    local script_path tmp source_abs install_abs
    script_path="${BASH_SOURCE[0]-}"
    mkdir -p "$(dirname "$INSTALL_PATH")"

    source_abs=""
    install_abs=""
    if [ -n "$script_path" ] && [ -f "$script_path" ]; then
        source_abs="$(cd "$(dirname "$script_path")" && pwd)/$(basename "$script_path")"
        if [ -e "$INSTALL_PATH" ]; then
            install_abs="$(cd "$(dirname "$INSTALL_PATH")" && pwd)/$(basename "$INSTALL_PATH")"
        fi
    fi

    if [ -n "$source_abs" ] && [ "$source_abs" = "$install_abs" ]; then
        chmod 700 "$INSTALL_PATH"
    elif [ -n "$source_abs" ]; then
        install -m 700 "$source_abs" "$INSTALL_PATH"
    else
        has_cmd curl || die "curl is required to install this script"
        tmp="$(mktemp)"
        trap 'rm -f "$tmp"' RETURN
        curl -fsSL "${RAW_BASE%/}/trojan-auto-cert-renew?ts=$(date +%s)" -o "$tmp"
        install -m 700 "$tmp" "$INSTALL_PATH"
        rm -f "$tmp"
        trap - RETURN
    fi

    log "[OK] 主脚本已安装: $INSTALL_PATH"
}

shell_quote() {
    printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
}

install_cron() {
    local cmd restart_cmd restart_line
    mkdir -p "$(dirname "$CRON_FILE")"

    cmd="RENEW_DAYS=$(shell_quote "$RENEW_DAYS")"
    cmd="${cmd} TROJAN_AUTO_CERT_CRON=1"
    cmd="${cmd} DISABLE_ACME_CRON=$(shell_quote "$DISABLE_ACME_CRON")"
    cmd="${cmd} SERVICE_STOP_LIST=$(shell_quote "$SERVICE_STOP_LIST")"
    cmd="${cmd} CERT_CHOICE=$(shell_quote "$CERT_CHOICE")"
    cmd="${cmd} ALWAYS_START_TROJAN=$(shell_quote "$ALWAYS_START_TROJAN")"
    cmd="${cmd} DISPLAY_TZ=$(shell_quote "$DISPLAY_TZ")"
    [ -n "$CONFIG_PATH" ] && cmd="${cmd} CONFIG_PATH=$(shell_quote "$CONFIG_PATH")"
    [ -n "$DOMAIN" ] && cmd="${cmd} DOMAIN=$(shell_quote "$DOMAIN")"
    [ -n "$TROJAN_CLI" ] && cmd="${cmd} TROJAN_CLI=$(shell_quote "$TROJAN_CLI")"
    [ -n "$TROJAN_SERVICE" ] && cmd="${cmd} TROJAN_SERVICE=$(shell_quote "$TROJAN_SERVICE")"
    cmd="${cmd} ${INSTALL_PATH} --scheduled >/dev/null 2>&1"

    restart_line=""
    if [ "$DAILY_RESTART" = "1" ]; then
        restart_cmd="TROJAN_AUTO_CERT_CRON=1"
        restart_cmd="${restart_cmd} DISPLAY_TZ=$(shell_quote "$DISPLAY_TZ")"
        [ -n "$TROJAN_SERVICE" ] && restart_cmd="${restart_cmd} TROJAN_SERVICE=$(shell_quote "$TROJAN_SERVICE")"
        restart_cmd="${restart_cmd} ${INSTALL_PATH} --restart >/dev/null 2>&1"
        restart_line="${RESTART_MINUTE} ${RESTART_HOUR} * * * root ${restart_cmd}"
    fi

    cat > "$CRON_FILE" <<EOF
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
${CHECK_MINUTE} ${CHECK_HOUR} * * * root ${cmd}
${restart_line}
EOF
    chmod 644 "$CRON_FILE"
    log "[OK] 定时任务已安装: $CRON_FILE"
    log "自动检查时间: 每天 ${CHECK_HOUR}:${CHECK_MINUTE}"
    if [ "$DAILY_RESTART" = "1" ]; then
        log "Trojan 自动重启时间: 每天 ${RESTART_HOUR}:${RESTART_MINUTE}"
    fi
}

choose_install_action() {
    local choice

    case "$INSTALL_ACTION" in
        automatic|immediate|domain|status)
            return 0
            ;;
        ask)
            ;;
        *)
            log "[WARN] 未识别的 INSTALL_ACTION=$INSTALL_ACTION，改用自动模式"
            INSTALL_ACTION="automatic"
            return 0
            ;;
    esac

    if [ ! -t 1 ] || [ ! -r /dev/tty ] || [ ! -w /dev/tty ]; then
        INSTALL_ACTION="automatic"
        log "没有交互终端，默认使用自动模式"
        return 0
    fi

    printf '\n请选择本次证书处理方式：\n' > /dev/tty
    printf '  1) 自动模式（推荐）：自动识别域名，仅在证书缺失或不足 %s 天时申请\n' "$RENEW_DAYS" > /dev/tty
    printf '  2) 手动立即申请：自动识别域名并马上申请、安装\n' > /dev/tty
    printf '  3) 手动指定域名：输入域名并马上申请、安装\n' > /dev/tty
    printf '  4) 只查看域名、证书和到期时间\n' > /dev/tty
    printf '请选择 [1-4，默认 1]: ' > /dev/tty
    IFS= read -r choice < /dev/tty || choice="1"

    case "${choice:-1}" in
        1) INSTALL_ACTION="automatic" ;;
        2) INSTALL_ACTION="immediate" ;;
        3) INSTALL_ACTION="domain" ;;
        4) INSTALL_ACTION="status" ;;
        *)
            log "[WARN] 选择无效，默认使用自动模式"
            INSTALL_ACTION="automatic"
            ;;
    esac

    if [ "$INSTALL_ACTION" = "domain" ] && [ -z "$MANUAL_DOMAIN" ]; then
        printf '请输入要申请证书的域名: ' > /dev/tty
        IFS= read -r MANUAL_DOMAIN < /dev/tty || MANUAL_DOMAIN=""
    fi
}

run_install_action() {
    case "$INSTALL_ACTION" in
        automatic)
            log "[OK] 已选择自动模式：开始识别域名并检查证书到期时间"
            "$INSTALL_PATH" --scheduled
            ;;
        immediate)
            log "已选择手动立即申请：开始自动识别域名"
            "$INSTALL_PATH" --force
            ;;
        domain)
            if [ -z "$MANUAL_DOMAIN" ]; then
                log "[WARN] 未输入域名，改为自动识别并立即申请"
                "$INSTALL_PATH" --force
            else
                log "已选择手动指定域名: $MANUAL_DOMAIN"
                DOMAIN="$MANUAL_DOMAIN" "$INSTALL_PATH" --force
            fi
            ;;
        status)
            log "已选择只查看状态"
            "$INSTALL_PATH" --status
            ;;
    esac
}

run_installer() {
    install_packages
    install_self
    install_cron

    if [ ! -f "$CRON_FILE" ] || ! grep -Fq "$INSTALL_PATH" "$CRON_FILE"; then
        die "cron install failed: $CRON_FILE"
    fi

    if [ "$RUN_CHECK" = "1" ]; then
        choose_install_action
        if ! run_install_action; then
            log "[WARN] 安装和定时任务已完成，但本次证书操作没有成功"
            log "检查日志后可重试: $INSTALL_PATH"
        fi
    fi

    log "[OK] 一体化脚本安装完成"
    log "查看状态: ${INSTALL_PATH} --status"
    log "立即申请: ${INSTALL_PATH}"
    log "卸载: ${INSTALL_PATH} --uninstall"
}

safe_purge_backup_dir() {
    case "$BACKUP_DIR" in
        ""|/|/root|/home|/usr|/var|/etc)
            log "[WARN] 拒绝删除不安全的备份目录: ${BACKUP_DIR:-empty}"
            return 1
            ;;
    esac
    [ -d "$BACKUP_DIR" ] || return 0
    find "$BACKUP_DIR" -mindepth 1 -delete
    rmdir "$BACKUP_DIR" 2>/dev/null || true
}

run_uninstaller() {
    local tmp
    rm -f "$CRON_FILE"

    if has_cmd crontab; then
        tmp="$(mktemp)"
        crontab -l 2>/dev/null | grep -v 'trojan-auto-cert-renew' > "$tmp" || true
        crontab "$tmp" 2>/dev/null || true
        rm -f "$tmp"
    fi

    if [ "$PURGE" = "1" ]; then
        rm -f "$LOG_FILE"
        safe_purge_backup_dir || true
        log "已清理日志: $LOG_FILE"
        log "已清理配置备份: $BACKUP_DIR"
    fi

    rm -f "$INSTALL_PATH"
    log "[OK] 已卸载: $INSTALL_PATH"
    log "[OK] 已删除定时任务: $CRON_FILE"
    log "证书、acme.sh、Trojan 配置和 Trojan 服务均未删除"
}

json_get() {
    local path="$1"
    [ -n "$CONFIG_PATH" ] && [ -f "$CONFIG_PATH" ] || return 0

    if command -v python3 >/dev/null 2>&1; then
        python3 - "$CONFIG_PATH" "$path" <<'PY'
